# ==============================================================================
# Google Gemini AI Configuration (Low-Latency Failover & 5-Min Cooldown)
# ==============================================================================
# Required for live AI responses (get one from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Fast, low-congestion Flash-Lite primary model
GEMINI_MODEL=gemini-3.5-flash-lite

# Ordered comma-separated fallback chain (instant failover + 5m cooldown on timeout/503/429/404)
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash

# Strict per-attempt timeout in milliseconds before aborting & failing over (default: 8000)
GEMINI_CALL_TIMEOUT_MS=8000

# ==============================================================================
# Store Routing Configuration
# ==============================================================================
# Store folder under src/stores/<slug>/ used by the Meta WhatsApp Cloud Webhook
DEFAULT_STORE_SLUG=demo-jewelry

# ==============================================================================
# Meta WhatsApp Cloud API Configuration (Channel 2: /api/webhook/whatsapp)
# ==============================================================================
# Arbitrary secret string configured in Meta App Dashboard -> WhatsApp -> Configuration -> Webhook
WHATSAPP_VERIFY_TOKEN=my_secure_webhook_verify_token

# Permanent or temporary System User Access Token from Meta Business Suite
WHATSAPP_ACCESS_TOKEN=EAAB...

# Phone Number ID from Meta App Dashboard -> WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID=123456789012345
